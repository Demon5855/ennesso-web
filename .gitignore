# =============================================================================
# Ennesso .gitignore — Node.js + Python + general
# =============================================================================

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# =============================================================================
# Node / Next.js
# =============================================================================
node_modules/
.next/
out/
build/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel

# TypeScript build info
*.tsbuildinfo

# =============================================================================
# Python / FastAPI
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# pytest cache
.pytest_cache/
.cache/

# Coverage
.coverage
htmlcov/
coverage.xml
*.lcov

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/

# =============================================================================
# Editors & OS
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# =============================================================================
# Docker
# =============================================================================
*.log
