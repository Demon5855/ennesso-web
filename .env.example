# =============================================================================
# Ennesso — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend — Next.js (NEXT_PUBLIC_ prefix = exposed to browser)
# -----------------------------------------------------------------------------

# Supabase project URL (find in Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend — FastAPI
# -----------------------------------------------------------------------------

# Supabase URL (same as above, used server-side)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service role key (⚠️ NEVER expose to browser — full DB access)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for AI-powered report generation
ANTHROPIC_API_KEY=

# CENACE CKAN open data API base URL
CENACE_CKAN_BASE_URL=https://datosabiertos.cenace.gob.ec/api

# CENACE XHR (SiSEWeb) base URL for real-time data scraping
CENACE_XHR_BASE_URL=https://www.cenace.gob.ec/SiSEWeb

# CENACE CKAN resource UUID for generation dispatch dataset
CENACE_GENERATION_RESOURCE_ID=

# ARCERNNR regulatory body base URL
ARCERNNR_BASE_URL=https://www.regulacionelectrica.gob.ec

# -----------------------------------------------------------------------------
# Payments — Lemon Squeezy
# -----------------------------------------------------------------------------

# Webhook signing secret (from Lemon Squeezy dashboard → Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------

# Environment: development | staging | production
APP_ENV=development

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Cron expression for the ingestion scheduler (default: every hour)
SCHEDULER_INGESTION_CRON=0 */1 * * *
